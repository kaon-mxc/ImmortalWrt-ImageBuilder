#!/bin/sh
# 仅清理旧版本脚本添加的固定解析，保留用户配置的其他域名和地址。
# -X 使用稳定的 section ID，删除匿名条目时不会因索引变化漏掉重复项。
for section in $(uci -q -X show dhcp | sed -n 's/^\(dhcp\.[^.]*\)=domain$/\1/p'); do
    [ "$(uci -q get "$section.name")" = 'time.android.com' ] || continue
    [ "$(uci -q get "$section.ip")" = '203.107.6.88' ] || continue
    uci -q delete "$section" || exit 1
done
uci commit dhcp
